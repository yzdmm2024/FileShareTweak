<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>FileShare</string>
    <!-- ★ 必须与 bundle 目录名一致：目录叫 FileShareTweakSettings.bundle，这里就填 FileShareTweakSettings -->
    <key>CFBundleExecutable</key>
    <string>FileShareTweakSettings</string>
    <key>CFBundleIdentifier</key>
    <string>com.ps.filesharetweak.settings</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>BNDL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.2</string>
    <key>CFBundleVersion</key>
    <string>1.0.2</string>
    <key>CFBundleName</key>
    <string>FileShare</string>
    <!-- ★ 设置页主控制器类，必须 = entry.plist 的 detail 字段，且类要在 bundle 里实现 -->
    <key>NSPrincipalClass</key>
    <string>FSTSettingsController</string>
    <key>PSControllerClasses</key>
    <array>
        <string>PSListController</string>
    </array>
</dict>
</plist>